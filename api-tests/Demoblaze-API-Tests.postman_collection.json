          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Add-to-cart request returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Add-to-cart response confirms the item was added\", function () {",
                  "    pm.expect(pm.response.text().trim()).to.eql(\"Item added.\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-006 - View Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{cartId}}\",\n  \"cookie\": \"Auth_token: {{authToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/viewcart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "viewcart"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"View-cart request returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Cart response contains an Items array\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"Items\").that.is.an(\"array\");",
                  "});",
                  "pm.test(\"Cart contains the item ID used by the add-to-cart request\", function () {",
                  "    const body = pm.response.json();",
                  "    const cartId = String(pm.variables.get(\"cartId\"));",
                  "    pm.expect(body.Items.some(function (item) { return String(item.id) === cartId; })).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-007 - Delete Cart Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{cartId}}\",\n  \"prod_id\": {{productId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/deleteitem",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deleteitem"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Delete-item request returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Delete-item response confirms deletion\", function () {",
                  "    pm.expect(pm.response.text().trim()).to.eql(\"Item deleted.\");",
                  "});",
                  "pm.test(\"Deleted item is absent from the cart\", function (done) {",
                  "    const baseUrl = pm.variables.replaceIn(\"{{baseUrl}}\");",
                  "    const cartId = pm.variables.get(\"cartId\");",
                  "    const authToken = pm.variables.get(\"authToken\");",
                  "    pm.sendRequest({",
                  "        url: baseUrl + \"/viewcart\",",
                  "        method: \"POST\",",
                  "        header: {\"Content-Type\": \"application/json\"},",
                  "        body: {",
                  "            mode: \"raw\",",
                  "            raw: JSON.stringify({id: cartId, cookie: \"Auth_token: \" + authToken})",
                  "        }",
                  "    }, function (error, response) {",
                  "        pm.expect(error).to.equal(null);",
                  "        pm.expect(response.code).to.eql(200);",
                  "        const body = response.json();",
                  "        pm.expect(body).to.have.property(\"Items\").that.is.an(\"array\");",
                  "        pm.expect(body.Items.some(function (item) { return String(item.id) === String(cartId); })).to.be.false;",
                  "        done();",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
