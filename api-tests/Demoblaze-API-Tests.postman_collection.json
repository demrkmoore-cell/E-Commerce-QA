{
  "info": {
    "name": "Demoblaze API Tests",
    "_postman_id": "ecommerce-qa-demoblaze-api",
    "description": "API test collection for the E-Commerce QA Portfolio. Includes product, authentication, cart, and negative API validation coverage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.demoblaze.com"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "cartId",
      "value": ""
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "timestamp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Products",
      "item": [
        {
          "name": "API-001 - Get Product Catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/entries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "entries"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Catalog request returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Catalog response contains a non-empty Items array\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"Items\").that.is.an(\"array\").and.is.not.empty;",
                  "});",
                  "pm.test(\"Catalog products contain required fields and valid prices\", function () {",
                  "    const items = pm.response.json().Items;",
                  "    items.forEach(function (item) {",
                  "        pm.expect(item).to.have.property(\"id\");",
                  "        pm.expect(String(item.id)).to.not.be.empty;",
                  "        pm.expect(item.title).to.be.a(\"string\").and.not.be.empty;",
                  "        pm.expect(Number(item.price)).to.be.above(0);",
                  "        pm.expect(item).to.have.property(\"cat\");",
                  "        pm.expect(item).to.have.property(\"desc\");",
                  "        pm.expect(item).to.have.property(\"img\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-002 - Get Product By ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{productId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/view",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "view"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Product lookup returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response matches the requested product ID\", function () {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product).to.have.property(\"id\");",
                  "    pm.expect(String(product.id)).to.eql(String(pm.variables.get(\"productId\")));",
                  "});",
                  "pm.test(\"Product response contains a title and positive price\", function () {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product.title).to.be.a(\"string\").and.not.be.empty;",
                  "    pm.expect(Number(product.price)).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "API-003 - Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "signup"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Signup request returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Signup response does not report a signup error\", function () {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body.toLowerCase()).not.to.include(\"errorMessage\".toLowerCase());",
                  "    pm.expect(body.toLowerCase()).not.to.include(\"this user already exist\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-004 - Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login request returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Successful login returns an authentication token\", function () {",
                  "    const body = pm.response.text().trim();",
                  "    pm.expect(body).to.match(/^Auth_token:\\s*\\S+$/);",
                  "    const token = body.replace(/^Auth_token:\\s*/, \"\").trim();",
                  "    pm.expect(token).to.not.be.empty;",
                  "    pm.collectionVariables.set(\"authToken\", token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
